    {
      "parameters": {
        "jsCode": "const lead=$('Get Lead').first().json;const co=$('Get Company').first().json;const job=$('Get Job').first().json;\nconst prompt=['You are the client success agent for '+co.company_name+'.','','BRAND VOICE:',co.brand_voice,'','CLIENT: '+lead.name,'DELIVERED WORK: '+job.description,'','Write a warm 1-week post-delivery check-in email that: 1) asks how the delivered work is performing, 2) asks for a short review or testimonial, 3) offers a referral incentive (one month 10% off for every referred client who signs).','Respond ONLY raw JSON: {\"subject\":\"<subject>\",\"body\":\"<email body>\"}'].join('\\n');\nreturn [{json:{lead:lead,company:co,request_body:{model:co.ai_model||'claude-sonnet-4-6',max_tokens:800,messages:[{role:'user',content:prompt}]}}}];"
      },
      "id": "a792619c-cd8b-4004-8e69-d8afc395c8d7",
      "name": "Build Retention Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;const lead=$('Build Retention Prompt').first().json.lead;const co=$('Build Retention Prompt').first().json.company;\nlet t=(r.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('');t=t.replace(/```json|```/g,'').trim();\nlet m;try{m=JSON.parse(t);}catch(e){m={subject:'How is everything going?',body:'Hi '+lead.name+', just checking in on the work we delivered. Would love your feedback — and if you know anyone who could use us, we offer a referral discount!'};}\nreturn [{json:{email:lead.email,name:lead.name,company_id:co.company_id,subject:m.subject,body:m.body,lead_id:lead.lead_id}}];"
      },
      "id": "16c3b594-55a7-4571-9b1d-37d27f0cc3ec",
      "name": "Parse Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
