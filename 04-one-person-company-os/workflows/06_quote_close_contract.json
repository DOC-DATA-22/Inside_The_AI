      },
      "id": "437ee081-1056-45ef-827e-048cf43d3401",
      "name": "AI Draft Quote",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        1104,
        0
      ],
      "credentials": {
        "anthropicApi": {
          "id": "eZp1eqL37xxxwxDc",
          "name": "Anthropic account 4"
        }
      }
