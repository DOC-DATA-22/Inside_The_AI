    {
      "parameters": {
        "jsCode": "const resp=$input.first().json;\nconst lead=$('Build Quote Prompt').first().json.lead;\nconst co=$('Build Quote Prompt').first().json.company;\nlet text='';\nif(Array.isArray(resp.content)){text=resp.content.filter(b=>b.type==='text').map(b=>b.text).join('\\n');}\nelse if(typeof resp.text==='string'){text=resp.text;}\nelse if(resp.message&&resp.message.content){text=Array.isArray(resp.message.content)?resp.message.content.map(b=>b.text||b).join('\\n'):String(resp.message.content);}\ntext=text.replace(/```json|```/g,'').trim();\nlet q;\ntry{q=JSON.parse(text);}catch(e){throw new Error('AI quote was not valid JSON — refusing to send an unverified offer. Raw: '+text.slice(0,200));}\nconst quote_id='qt_'+Date.now();\nconst accept='https://docdata.app.n8n.cloud/webhook/contract-accept?quote_id='+quote_id+'&company_id='+co.company_id;\nreturn [{json:{quote_id:quote_id,company_id:co.company_id,lead_id:lead.lead_id,email:lead.email,name:lead.name,amount:q.amount||0,line_items:q.line_items||'',email_subject:q.email_subject,email_body:q.email_body+'\\n\\nTo accept and get started, click here:\\n'+accept+'\\n\\nTerms: '+(co.invoice_terms||'Net 7')}}];"
      },
