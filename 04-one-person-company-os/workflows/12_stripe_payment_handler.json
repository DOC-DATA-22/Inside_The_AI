{
  "name": "OPC OS — 12 Stripe Payment Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "stripe-payment",
        "options": {}
      },
      "id": "11acba95-d10b-42fc-ada1-af87eb1107ef",
      "name": "Stripe Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -880,
        128
      ],
      "webhookId": "opc-stripe-payment",
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Only act on completed checkouts; extract our invoice_id\nconst event = $input.first().json.body || $input.first().json;\nif (!event || event.type !== 'checkout.session.completed') return [];\nconst s = (event.data && event.data.object) || {};\nconst invoice_id = s.client_reference_id || (s.metadata && s.metadata.invoice_id) || '';\nreturn [{ json: {\n  invoice_id: invoice_id,\n  amount_paid: typeof s.amount_total === 'number' ? s.amount_total / 100 : null,\n  payer_email: (s.customer_details && s.customer_details.email) || s.customer_email || '',\n  stripe_session: s.id || ''\n} }];"
      },
      "id": "4ed9eec0-a5cc-4523-b494-d9fe0a4b06ab",
      "name": "Extract Payment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        128
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "PASTE_YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Invoices",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "invoice_id",
              "lookupValue": "={{ $json.invoice_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b28d7a3b-623c-4668-8511-02ff02308219",
      "name": "Find Invoice",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -448,
        128
      ],
      "alwaysOutputData": true,
      "disabled": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "c-found",
              "leftValue": "={{ $json.invoice_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c-notpaid",
              "leftValue": "={{ $json.status }}",
              "rightValue": "paid",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6e9bc786-bdb9-43b1-8456-bc69ea489f6a",
      "name": "Valid Unpaid Invoice?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -224,
        128
      ]
    },
    {
      "parameters": {
        "url": "=https://docdata.app.n8n.cloud/webhook/invoice-paid?invoice_id={{ $json.invoice_id }}&company_id={{ $json.company_id }}",
        "options": {}
      },
      "id": "07cb6a9a-3292-4159-b832-7045ae9d4095",
      "name": "Mark Paid (via 08)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "PASTE_YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Events",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "timestamp": "={{ $now.toISO() }}",
            "company_id": "={{ $('Find Invoice').first().json.company_id }}",
            "workflow": "Stripe Payment",
            "event_type": "stripe.payment_received",
            "payload": "={{ JSON.stringify({ invoice_id: $('Extract Payment').first().json.invoice_id, amount: $('Extract Payment').first().json.amount_paid, payer: $('Extract Payment').first().json.payer_email }) }}"
          }
        },
        "options": {}
