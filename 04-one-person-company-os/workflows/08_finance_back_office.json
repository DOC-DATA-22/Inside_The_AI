    {
      "parameters": {
        "jsCode": "const now=Date.now();const out=[];\nfor(const item of $input.all()){const inv=item.json;\n  if(inv.status!=='sent'&&inv.status!=='overdue')continue;\n  const sent=Date.parse(inv.sent_at||'');if(isNaN(sent))continue;\n  const days=(now-sent)/86400000;\n  if(days>=7){out.push({json:{...inv,days_overdue:Math.floor(days)}});}}\nreturn out;"
      },
