      "parameters": {
        "jsCode": "const job=$('Get Job').first().json;\nconst quote=$('Get Quote').first().json;\nconst lead=$('Get Lead').first().json;\nconst co=$('Get Company').first().json;\nif(!job.job_id) throw new Error('Job not found');\nif(!lead.email) throw new Error('Lead email missing for job '+job.job_id);\nconst invoice_id='in_'+Date.now();\nconst paid='https://docdata.app.n8n.cloud/webhook/invoice-paid?invoice_id='+invoice_id+'&company_id='+co.company_id;\nreturn [{json:{invoice_id:invoice_id,company_id:co.company_id,job_id:job.job_id,amount:quote.amount,email:lead.email,name:lead.name,company_name:co.company_name,terms:co.invoice_terms||'Net 7',mark_paid_link:paid,line_items:quote.line_items}}];"
      },
