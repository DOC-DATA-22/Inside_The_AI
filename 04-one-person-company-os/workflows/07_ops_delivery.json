      "parameters": {
        "jsCode": "const quote=$('Get Quote').first().json;const lead=$('Get Lead').first().json;const co=$('Get Company').first().json;\nconst due=new Date(Date.now()+14*86400000).toISOString().slice(0,10);\nreturn [{json:{job_id:'jb_'+Date.now(),company_id:quote.company_id,quote_id:quote.quote_id,lead_id:lead.lead_id,email:lead.email,name:lead.name,description:('Deliver: '+quote.line_items),due_date:due,company:co,done_link:'https://docdata.app.n8n.cloud/webhook/job-delivered?job_id=jb_PLACEHOLDER'}}].map(i=>{i.json.done_link=i.json.done_link.replace('jb_PLACEHOLDER',i.json.job_id)+'&company_id='+i.json.company_id;return i;});"
      },
