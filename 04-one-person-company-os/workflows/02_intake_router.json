      "parameters": {
        "jsCode": "// ---- NORMALIZE ANY LEAD SOURCE INTO ONE STANDARD LEAD OBJECT ----\nconst body = $input.first().json.body || $input.first().json;\n\nconst companyId = (body.company_id || '').toString().trim();\n\n// Detect source: Twilio SMS, email forward, chat widget, or web form\nlet source = body.source;\nif (!source) {\n  if (body.From && body.Body) source = 'sms';\n  else if (body.subject || body.from_email) source = 'email';\n  else if (body.chat_session_id) source = 'chat';\n  else source = 'webform';\n}\n\nconst lead = {\n  lead_id: 'ld_' + Date.now() + '_' + Math.floor(Math.random() * 1000),\n  company_id: companyId,\n  created_at: new Date().toISOString(),\n  source: source,\n  name: body.name || body.from_name || 'Unknown',\n  email: body.email || body.from_email || '',\n  phone: body.phone || body.From || '',\n  message: body.message || body.Body || body.text || body.subject || '',\n  status: 'new',\n  score: '',\n  notes: ''\n};\n\nreturn [{ json: lead }];"
      },
