        "jsCode": "// Combine the normalized lead with tenant context for downstream workflows\nconst lead = $('Normalize Lead').first().json;\nconst company = $('Get Company Config').first().json;\n\nreturn [{\n  json: {\n    ...lead,\n    _company: {\n      company_name: company.company_name,\n      qualification_criteria: company.qualification_criteria,\n      brand_voice: company.brand_voice,\n      calendar_link: company.calendar_link,\n      ai_model: company.ai_model,\n      notification_channel: company.notification_channel\n    }\n  }\n}];"
