    {
      "parameters": {
        "jsCode": "const co=$input.first().json;\nconst prompt=['You are the content marketing agent for '+co.company_name+'.','','OFFERING: '+co.offering,'BRAND VOICE: '+co.brand_voice,'','DEMAND SIGNALS: consider what buyers of this offering are currently worried about — cost pressure, AI adoption, competition, hiring difficulty — and pick angles that meet those pains.','','Produce: 3 content angles for this week, and 1 ready-to-post LinkedIn post (150-220 words) in the brand voice on the strongest angle. No hashtag spam (max 3).','Respond ONLY raw JSON: {\"angles\":[\"a1\",\"a2\",\"a3\"],\"linkedin_post\":\"<post text>\"}'].join('\\n');\nreturn [{json:{company:co,request_body:{model:co.ai_model||'claude-sonnet-4-6',max_tokens:900,messages:[{role:'user',content:prompt}]}}}];"
      },
      "id": "e62a043c-d586-4e08-be55-33e99ffae65a",
      "name": "Build Content Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;const co=$('Build Content Prompt').first().json.company;\nlet t=(r.content||[]).filter(b=>b.type==='text').map(b=>b.text).join('');t=t.replace(/```json|```/g,'').trim();\nlet m;try{m=JSON.parse(t);}catch(e){m={angles:['(parse failed)'],linkedin_post:t.slice(0,500)};}\nreturn [{json:{company_id:co.company_id,channel:co.notification_channel,company_name:co.company_name,angles:m.angles.join('\\n• '),post:m.linkedin_post}}];"
      },
      "id": "df1f3933-83f5-4974-b165-42e051c5d26d",
      "name": "Parse Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
