   "parameters": {
    "options": {}
   },
   "id": "chat3",
   "name": "Chat With the Agent",
   "type": "@n8n/n8n-nodes-langchain.chatTrigger",
   "typeVersion": 1.1,
   "position": [
    180,
    1300
   ],
   "webhookId": "three-levels-agent"
  },
  {
   "parameters": {
    "options": {
     "systemMessage": "You are the user's work assistant \u2014 an executive-assistant style agent with tools. Decide for yourself which tool each request needs: read My Inbox for anything about email; use Draft a Reply to WRITE a reply as a Gmail draft when the user asks you to respond to something (always a draft, never sent \u2014 say 'draft is in your Drafts folder' when done); check My Calendar for schedule, meetings, or availability; use the Calculator for arithmetic like billing math. For meeting-prep questions, combine Calendar AND Inbox to brief them. Be concise, practical, and briefly mention which tools you used so the human sees your decisions."
    }
   },
   "id": "agent3",
   "name": "The Agent (it decides)",
   "type": "@n8n/n8n-nodes-langchain.agent",
