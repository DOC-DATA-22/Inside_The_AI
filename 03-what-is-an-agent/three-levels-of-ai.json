   "id": "gm3",
   "name": "My Inbox (24h)",
   "type": "n8n-nodes-base.gmailTool",
   "typeVersion": 2.1,
   "position": [
    800,
    1490
   ],
   "notes": "Gmail credential. Fixed fetch: last 24h inbox \u2014 the agent decides WHEN to use it."
  },
  {
   "parameters": {
    "operation": "getAll",
    "calendar": {
     "__rl": true,
     "mode": "list",
     "value": "primary"
    },
    "limit": 20,
    "options": {
     "timeMin": "={{ $now.startOf('day').toISO() }}",
     "timeMax": "={{ $now.endOf('day').plus({ days: 1 }).toISO() }}"
    }
   },
   "id": "cal3",
   "name": "My Calendar (today+tomorrow)",
   "type": "n8n-nodes-base.googleCalendarTool",
   "typeVersion": 1.3,
   "position": [
    960,
    1490
   ],
   "notes": "Google Calendar credential. Fixed window \u2014 the agent decides WHEN to look."
  },
  {
   "parameters": {
    "resource": "draft",
    "operation": "create",
    "subject": "={{ $fromAI('subject', 'the reply subject line, usually Re: the original subject') }}",
    "emailType": "text",
    "message": "={{ $fromAI('body', 'the full reply text, professional and warm, ready to send') }}",
    "options": {
     "sendTo": "={{ $fromAI('to', 'the recipient email address from the original message') }}"
    }
   },
   "id": "draft3",
   "name": "Draft a Reply",
   "type": "n8n-nodes-base.gmailTool",
   "typeVersion": 2.1,
   "position": [
    800,
    1620
   ],
   "notes": "Same Gmail credential. Creates a DRAFT \u2014 the agent never sends. You review and hit send yourself."
  }
