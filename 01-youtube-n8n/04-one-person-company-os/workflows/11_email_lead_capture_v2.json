    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst lead = $('Build Intent Prompt').first().json.lead;\nconst msg = $('Build Intent Prompt').first().json.msg;\nlet text = '';\nif (Array.isArray(resp.content)) text = resp.content.filter(b=>b.type==='text').map(b=>b.text).join('');\nelse if (typeof resp.text === 'string') text = resp.text;\nelse if (resp.message && resp.message.content) text = Array.isArray(resp.message.content) ? resp.message.content.map(b=>b.text||b).join('') : String(resp.message.content);\ntext = text.replace(/```json|```/g, '').trim();\nlet v; try { v = JSON.parse(text); } catch(e) { v = { intent: 'other', summary: 'unparseable reply' }; }\nconst quotable = ['new','qualified','pending_review'].includes(String(lead.status||'').trim());\nreturn [{ json: { lead_id: lead.lead_id, company_id: lead.company_id, email: lead.email, name: lead.name, status: lead.status, intent: v.intent, summary: v.summary, preview: msg.message.slice(0,300), auto_quote: v.intent === 'buy' && quotable } }];"
      },
