    {
      "parameters": {
        "jsCode": "const lead = $('Check Existing Lead').first().json;\nconst msg = $('Normalize Email').first().json;\nconst prompt = ['You classify a reply email from a sales lead.', '', 'REPLY:', msg.message, '', 'Classify the sender\\'s intent. Respond ONLY raw JSON, no fences:', '{\"intent\": \"buy\" | \"question\" | \"negative\" | \"other\", \"summary\": \"<one sentence>\"}', '', 'buy = wants to proceed, sign up, get access, or clearly says yes. question = asking something before deciding. negative = not interested / unsubscribe. other = anything else.'].join('\\n');\nreturn [{ json: { lead, msg, request_body: { model: 'claude-sonnet-4-6', max_tokens: 200, messages: [{ role: 'user', content: prompt }] } } }];"
      },
