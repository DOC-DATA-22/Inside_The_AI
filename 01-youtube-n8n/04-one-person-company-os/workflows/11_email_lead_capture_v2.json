    {
      "parameters": {
        "jsCode": "const m = $input.first().json;\nconst fromRaw = m.from || m.From || '';\nconst emailMatch = String(fromRaw).match(/<(.+?)>/);\nconst email = emailMatch ? emailMatch[1] : String(fromRaw).trim();\nconst name = String(fromRaw).replace(/<.+?>/, '').replace(/\"/g, '').trim() || email;\nconst subject = m.subject || m.Subject || '';\nconst body = (m.textPlain || m.snippet || m.text || '').slice(0, 1500);\nif (!email || /mailer-daemon|noreply|no-reply/i.test(email)) return [];\nreturn [{ json: { email, name, message: (subject + ' — ' + body).trim() } }];"
      },
