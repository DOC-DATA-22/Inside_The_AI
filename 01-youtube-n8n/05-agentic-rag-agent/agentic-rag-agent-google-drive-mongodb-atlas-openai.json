    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Given a file_id, returns the full text of that document by joining all of its chunks. Use this when a search snippet isn't enough and you need to read a whole document.",
        "operation": "aggregate",
        "collection": "local_docs",
        "query": "=[{\"$match\": {\"file_id\": \"{{ $fromAI('file_id', 'The file_id of the document to read, from listDocuments or searchDocuments') }}\"}}, {\"$group\": {\"_id\": \"$file_id\", \"chunks\": {\"$push\": \"$text\"}}}, {\"$project\": {\"_id\": 0, \"document_text\": {\"$reduce\": {\"input\": \"$chunks\", \"initialValue\": \"\", \"in\": {\"$concat\": [\"$$value\", \" \", \"$$this\"]}}}}}]"
      },
      "id": "9d360bc2-e78e-4c74-af9f-71134a12e630",
      "name": "Get File Contents",
      "type": "n8n-nodes-base.mongoDbTool",
