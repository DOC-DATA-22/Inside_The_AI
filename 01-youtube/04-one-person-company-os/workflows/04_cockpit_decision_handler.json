      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst action = (q.action || '').toLowerCase();\nif (!q.lead_id || !['approve','reject'].includes(action)) {\n  return [{ json: { valid: false, error: 'Missing lead_id or invalid action' } }];\n}\nreturn [{ json: { valid: true, lead_id: q.lead_id, company_id: q.company_id || '', action: action } }];"
      },
