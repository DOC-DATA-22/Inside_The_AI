    {
      "parameters": {
        "jsCode": "// Recover the stored reply draft and merge with the decision\nconst lead = $input.first().json;\nconst decision = $('Parse Decision').first().json;\n\nif (!lead || !lead.lead_id) {\n  return [{ json: { valid: false, error: 'Lead not found: ' + decision.lead_id } }];\n}\n\nconst notes = lead.notes || '';\nlet subject = 'Re: your inquiry';\nlet body = '';\nconst subjMatch = notes.match(/REPLY_DRAFT_SUBJECT::(.*?)\\|\\|/s);\nconst bodyMatch = notes.match(/REPLY_DRAFT_BODY::([\\s\\S]*)/);\nif (subjMatch) subject = subjMatch[1];\nif (bodyMatch) body = bodyMatch[1];\n\nreturn [{ json: {\n  valid: true,\n  action: decision.action,\n  lead_id: lead.lead_id,\n  company_id: lead.company_id,\n  email: lead.email,\n  name: lead.name,\n  reply_subject: subject,\n  reply_body: body,\n  has_draft: body.length > 0\n} }];"
      },
      "id": "836a46c8-ffac-4f20-9e2d-c504088131a6",
