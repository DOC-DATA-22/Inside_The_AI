{
  "name": "OPC OS — 03 Qualify & Book",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "qualify",
        "options": {}
      },
      "id": "c42f4fef-6281-4f44-b345-7238acc4e736",
      "name": "Qualify Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        224
      ],
      "webhookId": "opc-qualify"
    },
    {
      "parameters": {
        "jsCode": "// Build the AI request from the lead + tenant config passed by the Intake Router\nconst input = $input.first().json.body || $input.first().json;\nconst lead = input;\nconst co = input._company || {};\n\nconst prompt = [\n  'You are the lead qualification agent for ' + (co.company_name || 'this company') + '.',\n  '',\n  'QUALIFICATION CRITERIA:',\n  co.qualification_criteria || 'Any genuine business inquiry qualifies.',\n  '',\n  'BRAND VOICE FOR THE REPLY:',\n  co.brand_voice || 'Professional and friendly.',\n  '',\n  'BOOKING LINK (include it ONLY if qualified): ' + (co.calendar_link || ''),\n  '',\n  'LEAD:',\n  'Name: ' + lead.name,\n  'Email: ' + lead.email,\n  'Phone: ' + lead.phone,\n  'Source: ' + lead.source,\n  'Message: ' + lead.message,\n  '',\n  'Score this lead 0-100 against the criteria. Decide: qualified (clearly meets criteria), borderline (unclear or partially meets), or disqualified (clearly does not meet).',\n  'Write a reply email in the brand voice. If qualified, invite them to book via the booking link. If borderline, write the reply you WOULD send so a human can approve it. If disqualified, write a short polite decline.',\n  '',\n  'Respond with ONLY raw JSON, no markdown fences, exactly this shape:',\n  '{\"score\": <number>, \"decision\": \"qualified|borderline|disqualified\", \"reasoning\": \"<one sentence>\", \"reply_subject\": \"<subject>\", \"reply_body\": \"<email body>\"}'\n].join('\\n');\n\nreturn [{\n  json: {\n    lead: lead,\n    company: co,\n    request_body: {\n      model: co.ai_model || 'claude-sonnet-4-6',\n      max_tokens: 1024,\n      messages: [{ role: 'user', content: prompt }]\n    }\n  }\n}];"
      },
      "id": "6ef7db17-0d8f-4561-9279-e96c99e2b43e",
      "name": "Build AI Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -976,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "// Parse the model's JSON verdict and re-attach lead + company context\nconst resp = $input.first().json;\nconst lead = $('Build AI Prompt').first().json.lead;\nconst company = $('Build AI Prompt').first().json.company;\n\nlet text = '';\nif (Array.isArray(resp.content)) {\n  text = resp.content.filter(b => b.type === 'text').map(b => b.text).join('\\n');\n}\ntext = text.replace(/```json|```/g, '').trim();\n\nlet verdict;\ntry {\n  verdict = JSON.parse(text);\n} catch (e) {\n  verdict = { score: 0, decision: 'borderline', reasoning: 'AI response was not valid JSON — routed to human review. Raw: ' + text.slice(0, 200), reply_subject: 'Re: your inquiry', reply_body: '' };\n}\n\nconst decision = ['qualified','borderline','disqualified'].includes(verdict.decision) ? verdict.decision : 'borderline';\n\nreturn [{\n  json: {\n    ...lead,\n    _company: company,\n    score: verdict.score,\n    decision: decision,\n    reasoning: verdict.reasoning || '',\n    reply_subject: verdict.reply_subject || ('Re: your inquiry to ' + (company.company_name || '')),\n    reply_body: verdict.reply_body || ''\n  }\n}];"
      },
      "id": "732685f8-af23-433d-b825-03ad168bbc6c",
      "name": "Parse Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
